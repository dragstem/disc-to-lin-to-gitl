# Environment Variables for Linear-GitLab Synchronization Application

# Linear API Configuration
LINEAR_API_KEY=your_linear_api_key_here
LINEAR_TEAM_NAME=your_linear_team_name_here

# GitLab API Configuration
GITLAB_TOKEN=your_gitlab_personal_access_token_here
GITLAB_PROJECT_ID=your_gitlab_project_id_here
GITLAB_BASE_URL=https://gitlab.com/api/v4
# Synchronization Configuration
SYNC_INTERVAL=300  # Synchronization interval in seconds (default 5 minutes)

# Discord API Configuration (optional - set DISCORD_ENABLED=true to enable)
DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_FORUM_CHANNEL_ID=your_discord_forum_channel_id_here
DISCORD_API_BASE_URL=https://discord.com/api/v9
DISCORD_SYNC_INTERVAL=600  # Discord sync interval in seconds (default 10 minutes)



# Database Configuration
DATABASE_PATH=linear_gitlab_sync.db

# Logging Configuration
LOG_LEVEL=INFO

# Additional optional settings
DRY_RUN=false